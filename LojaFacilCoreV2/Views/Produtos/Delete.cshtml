@model LojaFacilCoreV2.Models.Produto

@{
    ViewData["Title"] = "Excluir Produto";
}

<h2 class="text-center mb-4 text-danger">🗑️ Excluir Produto</h2>

<h4 class="text-center">Tem certeza de que deseja excluir este produto?</h4>
<hr />

<div class="card shadow-sm border-0">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-2 fw-bold">Nome</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Nome)</dd>

            <dt class="col-sm-2 fw-bold">Categoria</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Categoria)</dd>

            <dt class="col-sm-2 fw-bold">Preço (R$)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Preco)</dd>

            <dt class="col-sm-2 fw-bold">Estoque</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Estoque)</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="text-center mt-4">
                <input type="submit" value="Excluir" class="btn btn-danger px-4" />
                <a asp-action="Index" class="btn btn-secondary ms-2 px-4">Cancelar</a>
            </div>
        </form>
    </div>
</div>
