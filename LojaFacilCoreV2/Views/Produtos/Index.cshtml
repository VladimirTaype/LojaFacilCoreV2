@model IEnumerable<LojaFacilCoreV2.Models.Produto>

@{
    ViewData["Title"] = "Lista de Produtos";
    var tipoUsuario = Context.Session.GetString("TipoUsuario");
}

<h2 class="text-center mt-3">🛒 Produtos Disponíveis</h2>

@if (tipoUsuario == "Gerente")
{
    <div class="mb-3">
        <button id="btnNovoProduto" class="btn btn-primary">
            + Registrar Novo Produto
        </button>
    </div>

    <!-- 🔹 Formulário para adicionar novo produto (inicialmente oculto) -->
    <div id="formNovoProduto" class="card p-3 mb-4 shadow-sm" style="display:none;">
        <h5 class="mb-3">Cadastrar Novo Produto</h5>
        <form asp-controller="Produtos" asp-action="Create" method="post">
            <div class="row g-3">
                <div class="col-md-3">
                    <label for="Nome" class="form-label">Nome</label>
                    <input name="Nome" class="form-control" required />
                </div>

                <div class="col-md-3">
                    <label for="Categoria" class="form-label">Categoria</label>
                    <input name="Categoria" class="form-control" required />
                </div>

                <div class="col-md-2">
                    <label for="Preco" class="form-label">Preço (R$)</label>
                    <input name="Preco" type="number" step="0.01" class="form-control" required />
                </div>

                <div class="col-md-2">
                    <label for="Estoque" class="form-label">Quantidade</label>
                    <input name="Estoque" type="number" min="0" class="form-control" required />
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">Salvar</button>
                </div>
            </div>
        </form>
    </div>
}

<!-- 🔹 Tabela de produtos -->
<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>Nome</th>
            <th>Categoria</th>
            <th>Preço (R$)</th>
            <th>Quantidade</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.Categoria</td>
                <td>@item.Preco.ToString("F2")</td>
                <td>@item.Estoque</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalhes</a>

                    @if (tipoUsuario == "Gerente")
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Excluir</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        // 🔹 Exibir ou ocultar o formulário ao clicar no botão
        document.getElementById("btnNovoProduto").addEventListener("click", function () {
            const form = document.getElementById("formNovoProduto");
            form.style.display = form.style.display === "none" ? "block" : "none";
        });
    </script>
}
