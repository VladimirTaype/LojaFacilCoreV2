<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LojaFácil</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LojaFacilCoreV2.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-white" asp-controller="Home" asp-action="Index">🛍️ LojaFácil</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Produtos" asp-action="Index">Produtos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Vendas" asp-action="Index">Vendas</a>
                        </li>
                    </ul>

                    <button id="toggleTheme" class="btn btn-sm btn-outline-light me-3">🌙 Modo Escuro</button>

                    @if (Context.Session.GetString("NomeUsuario") != null)
                    {
                        var tipo = Context.Session.GetString("TipoUsuario");
                        <div class="text-end text-white me-3">
                            <span>
                                👋 Bem-vindo, <strong>@Context.Session.GetString("NomeUsuario")</strong> (<em>@tipo</em>)
                            </span>
                            |
                            <a asp-controller="Auth" asp-action="Logout" class="text-warning text-decoration-none ms-1">Sair</a>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-light">Entrar</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - LojaFácilCoreV2 -
            <a asp-controller="Home" asp-action="Privacy">Privacidade</a>
        </div>
    </footer>

    <!-- Scripts principais -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Scripts específicos das views -->
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // 🌗 Alternar tema escuro/claro
        document.addEventListener("DOMContentLoaded", function () {
            const btnTheme = document.getElementById("toggleTheme");
            const savedTheme = localStorage.getItem("theme");

            if (savedTheme === "dark") {
                document.body.classList.add("dark-mode");
                btnTheme.textContent = "☀️ Modo Claro";
            }

            btnTheme.addEventListener("click", function () {
                document.body.classList.toggle("dark-mode");
                if (document.body.classList.contains("dark-mode")) {
                    localStorage.setItem("theme", "dark");
                    this.textContent = "☀️ Modo Claro";
                } else {
                    localStorage.setItem("theme", "light");
                    this.textContent = "🌙 Modo Escuro";
                }
            });
        });

        // ✅ Força o jQuery Validation a aceitar vírgula como separador decimal
        (function ($) {
            if ($ && $.validator && $.validator.methods) {
                $.extend($.validator.methods, {
                    number: function (value, element) {
                        return this.optional(element) || /^-?\d+(,\d+)?$/.test(value);
                    }
                });
            }
        })(jQuery);
    </script>
</body>
</html>
